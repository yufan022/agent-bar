{
  "name": "agent-bar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist-electron/main.js",
  "bin": {
    "agent-bridge": "./dist-electron/cli/agent-bridge.js",
    "agent-bar": "./dist-electron/cli/agent-bar.js"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,node,app \"vite\" \"node scripts/build-node.mjs --watch\" \"wait-on http://127.0.0.1:1420 dist-electron/main.js && nodemon --watch dist-electron/main.js --watch dist-electron/preload.cjs --exec electron .\"",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.lib.json --noEmit && node scripts/build-node.mjs && vite build",
    "start": "electron .",
    "dist": "pnpm build && node scripts/rebuild-sensor.mjs && electron-builder",
    "postinstall": "node scripts/rebuild-sensor.mjs",
    "test": "node --test lib/bridge/bridge.test.ts lib/quota/quota.test.ts lib/monitor/monitor.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.lib.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "macos-temperature-sensor": "2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.9.1",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.6",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.yufan.agent-bar",
    "productName": "agent-bar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist-electron/**/*",
      "assets/icons/**/*",
      "package.json",
      "node_modules/systeminformation/**/*",
      "node_modules/macos-temperature-sensor/**/*"
    ],
    "asarUnpack": [
      "node_modules/macos-temperature-sensor/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "asar": true
  }
}
